{
  "schema_version": 1,
  "order": [
    "freetype",
    "fribidi",
    "harfbuzz",
    "libass",
    "libplacebo",
    "lua",
    "dav1d",
    "xz",
    "ffmpeg",
    "mpv"
  ],
  "ninja": {
    "commands": [
      [
        "{cmake}",
        "-S",
        "{source}",
        "-B",
        "{build}",
        "-G",
        "Unix Makefiles",
        "-DCMAKE_BUILD_TYPE=Release",
        "-DBUILD_TESTING=OFF",
        "-DCMAKE_C_COMPILER=/usr/bin/clang",
        "-DCMAKE_CXX_COMPILER=/usr/bin/clang++",
        "-DCMAKE_OSX_SYSROOT={sdk}",
        "-DCMAKE_OSX_DEPLOYMENT_TARGET=14.0",
        "-DCMAKE_OSX_ARCHITECTURES=arm64"
      ],
      [
        "{cmake}",
        "--build",
        "{build}",
        "--parallel",
        "{jobs}"
      ]
    ]
  },
  "freetype": {
    "commands": [
      [
        "{cmake}",
        "-S",
        "{source}",
        "-B",
        "{build}",
        "-G",
        "Unix Makefiles",
        "-DCMAKE_POLICY_VERSION_MINIMUM=3.5",
        "-DCMAKE_BUILD_TYPE=Release",
        "-DBUILD_SHARED_LIBS=ON",
        "-DCMAKE_INSTALL_PREFIX={prefix}",
        "-DCMAKE_INSTALL_LIBDIR=lib",
        "-DCMAKE_C_COMPILER=/usr/bin/clang",
        "-DCMAKE_OSX_SYSROOT={sdk}",
        "-DCMAKE_OSX_DEPLOYMENT_TARGET=14.0",
        "-DCMAKE_OSX_ARCHITECTURES=arm64",
        "-DFT_DISABLE_ZLIB=TRUE",
        "-DFT_DISABLE_BZIP2=TRUE",
        "-DFT_DISABLE_PNG=TRUE",
        "-DFT_DISABLE_HARFBUZZ=TRUE",
        "-DFT_DISABLE_BROTLI=TRUE"
      ],
      [
        "{cmake}",
        "--build",
        "{build}",
        "--parallel",
        "{jobs}"
      ],
      [
        "{cmake}",
        "--install",
        "{build}"
      ]
    ]
  },
  "fribidi": {
    "meson_options": [
      "-Ddocs=false",
      "-Dbin=false",
      "-Dtests=false"
    ],
    "commands": []
  },
  "harfbuzz": {
    "meson_options": [
      "-Dtests=disabled",
      "-Dutilities=disabled",
      "-Ddocs=disabled",
      "-Dintrospection=disabled",
      "-Dfreetype=disabled"
    ],
    "commands": []
  },
  "libass": {
    "meson_options": [
      "-Dcoretext=enabled",
      "-Dfontconfig=disabled",
      "-Dlibunibreak=disabled",
      "-Dasm=disabled",
      "-Dtest=false",
      "-Dprofile=false"
    ],
    "commands": []
  },
  "libplacebo": {
    "meson_options": [
      "-Ddemos=false",
      "-Dtests=false",
      "-Dbench=false",
      "-Dfuzz=false",
      "-Dvulkan=disabled",
      "-Dopengl=disabled",
      "-Dd3d11=disabled",
      "-Dglslang=disabled",
      "-Dshaderc=disabled",
      "-Dlcms=disabled",
      "-Ddovi=enabled",
      "-Dlibdovi=disabled"
    ],
    "commands": []
  },
  "lua": {
    "commands": [
      [
        "/usr/bin/make",
        "-C",
        "{source}/src",
        "-j{jobs}",
        "liblua.a",
        "CC=/usr/bin/clang",
        "MYCFLAGS=-arch arm64 -isysroot {sdk} -mmacosx-version-min=14.0 -DLUA_USE_MACOSX"
      ]
    ],
    "copies": {
      "src/liblua.a": "lib/liblua52.a",
      "src/lua.h": "include/lua52/lua.h",
      "src/luaconf.h": "include/lua52/luaconf.h",
      "src/lualib.h": "include/lua52/lualib.h",
      "src/lauxlib.h": "include/lua52/lauxlib.h"
    },
    "generated": {
      "lib/pkgconfig/lua52.pc": "prefix={prefix}\nlibdir=${{prefix}}/lib\nincludedir=${{prefix}}/include/lua52\n\nName: Lua\nDescription: Lua 5.2.4 static interpreter for libmpv option compatibility\nVersion: 5.2.4\nLibs: -L${{libdir}} -llua52\nLibs.private: -lm\nCflags: -I${{includedir}}\n"
    }
  },
  "ffmpeg": {
    "commands": [
      [
        "{source}/configure",
        "--prefix={prefix}",
        "--cc=/usr/bin/clang",
        "--cxx=/usr/bin/clang++",
        "--arch=arm64",
        "--target-os=darwin",
        "--sysroot={sdk}",
        "--extra-cflags=-I{prefix}/include -mmacosx-version-min=14.0",
        "--extra-ldflags=-L{prefix}/lib -mmacosx-version-min=14.0 -Wl,-headerpad_max_install_names",
        "--disable-autodetect",
        "--disable-network",
        "--enable-shared",
        "--disable-static",
        "--disable-programs",
        "--disable-doc",
        "--disable-debug",
        "--disable-avdevice",
        "--disable-postproc",
        "--enable-videotoolbox",
        "--enable-audiotoolbox",
        "--enable-libdav1d",
        "--enable-zlib",
        "--enable-bzlib",
        "--enable-lzma"
      ],
      [
        "/usr/bin/make",
        "-j{jobs}"
      ],
      [
        "/usr/bin/make",
        "install"
      ]
    ]
  },
  "mpv": {
    "meson_options": [
      "-Dlibmpv=true",
      "-Dcplayer=false",
      "-Dbuild-date=false",
      "-Dgl=disabled",
      "-Dlua=lua52",
      "-Dcoreaudio=enabled",
      "-Diconv=enabled",
      "-Dzlib=enabled",
      "-Dmanpage-build=disabled",
      "-Dhtml-build=disabled",
      "-Dpdf-build=disabled"
    ],
    "commands": [],
    "source_generated": {
      "snapshot_version": "0.38.0-c0dd2b32-controlled\n"
    }
  },
  "dav1d": {
    "meson_options": [
      "-Denable_tools=false",
      "-Denable_tests=false",
      "-Denable_examples=false",
      "-Denable_docs=false",
      "-Denable_asm=true"
    ],
    "commands": []
  },
  "xz": {
    "commands": [
      [
        "{cmake}",
        "-S",
        "{source}",
        "-B",
        "{build}",
        "-G",
        "Unix Makefiles",
        "-DCMAKE_BUILD_TYPE=Release",
        "-DBUILD_SHARED_LIBS=ON",
        "-DBUILD_TESTING=OFF",
        "-DCMAKE_INSTALL_PREFIX={prefix}",
        "-DCMAKE_INSTALL_LIBDIR=lib",
        "-DCMAKE_C_COMPILER=/usr/bin/clang",
        "-DCMAKE_OSX_SYSROOT={sdk}",
        "-DCMAKE_OSX_DEPLOYMENT_TARGET=14.0",
        "-DCMAKE_OSX_ARCHITECTURES=arm64",
        "-DXZ_NLS=OFF",
        "-DXZ_TOOL_XZ=OFF",
        "-DXZ_TOOL_XZDEC=OFF",
        "-DXZ_TOOL_LZMADEC=OFF",
        "-DXZ_TOOL_LZMAINFO=OFF",
        "-DXZ_TOOL_SCRIPTS=OFF",
        "-DXZ_DOC=OFF",
        "-DXZ_DOXYGEN=OFF"
      ],
      [
        "{cmake}",
        "--build",
        "{build}",
        "--parallel",
        "{jobs}"
      ],
      [
        "{cmake}",
        "--install",
        "{build}"
      ]
    ]
  }
}
